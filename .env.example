# ==========================================
# Backend Configuration (Flask API)
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-long-random-string
JWT_SECRET_KEY=replace-with-another-secure-jwt-key
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai_research_db?retryWrites=true&w=majority

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# ==========================================
# Frontend Configuration (React SPA)
# ==========================================
# Vite apps require VITE_ prefix to be loaded into client-side environment
VITE_API_BASE_URL=http://localhost:5000/api
